# Copie para .env e ajuste conforme necessário.
REQSCRIBA_DATA_DIR=./data

# LLM: ollama | openai_compatible (qualquer servidor com API compatível com a da OpenAI)
# ATENÇÃO: com um servidor fora desta máquina, o conteúdo das fontes é enviado a ele.
REQSCRIBA_LLM_PROVIDER=ollama
REQSCRIBA_LLM_MODEL=qwen3.5:4b
# Obrigatória para openai_compatible (ex.: http://localhost:1234/v1). No Ollama, tem prioridade sobre OLLAMA_URL.
REQSCRIBA_LLM_BASE_URL=
REQSCRIBA_LLM_API_KEY=
REQSCRIBA_LLM_TIMEOUT=900
REQSCRIBA_LLM_TEMPERATURE=0.1
# Só no provedor ollama
REQSCRIBA_LLM_NUM_CTX=8192
REQSCRIBA_OLLAMA_URL=http://localhost:11434

# Embeddings: ollama | openai_compatible | hash (hash = modo offline, sem modelo de embeddings)
# Sem URL própria e com o mesmo provedor do LLM, reutiliza a URL e a chave do LLM.
# Ao trocar o modelo, execute `make reindex` com a API parada.
REQSCRIBA_EMBEDDINGS_PROVIDER=ollama
REQSCRIBA_EMBEDDING_MODEL=bge-m3
REQSCRIBA_EMBEDDINGS_BASE_URL=
REQSCRIBA_EMBEDDINGS_API_KEY=

# chroma | memory
REQSCRIBA_VECTOR_STORE=chroma
REQSCRIBA_WHISPER_MODEL=small
REQSCRIBA_WHISPER_DEVICE=cpu
REQSCRIBA_WHISPER_COMPUTE_TYPE=int8
REQSCRIBA_TRANSCRIPTION_LANGUAGE=pt
REQSCRIBA_MAX_AUDIO_MB=200
REQSCRIBA_MAX_DOCUMENT_MB=20
REQSCRIBA_CHUNK_SIZE=1000
REQSCRIBA_CHUNK_OVERLAP=150
REQSCRIBA_TRANSCRIPT_WINDOW_CHARS=800
REQSCRIBA_GENERATION_BATCH_CHARS=6000
REQSCRIBA_RAG_TOP_K=4
REQSCRIBA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
REQSCRIBA_LOG_LEVEL=INFO
